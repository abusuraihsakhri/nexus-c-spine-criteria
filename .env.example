# Nexus C Spine Criteria — Environment Configuration
# Copy this file to .env and customize for your deployment.

# HMAC-SHA256 Audit Trail Secret Key
# MUST be a strong random value in production (e.g., `python -c "import secrets; print(secrets.token_hex(32))"`)
AUDIT_SECRET_KEY=

# LLM Provider: mock, ollama, anthropic, openai
MODEL_PROVIDER=mock

# API Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
