{
  "openapi": "3.1.0",
  "info": {
    "title": "NEXUS Cervical Spine Criteria API",
    "description": "Five-item NEXUS low-risk decision support; use with clinical judgment.",
    "version": "3.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Service health check",
        "responses": {"200": {"description": "Service available"}}
      }
    },
    "/api/nexus": {
      "post": {
        "summary": "Evaluate five NEXUS cervical-spine criteria",
        "description": "True means the adverse finding is present. Unassessed fields yield INCOMPLETE unless another finding is positive. This endpoint does not diagnose injury.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "midline_tenderness": {"type": ["boolean", "null"], "default": null},
                  "intoxication": {"type": ["boolean", "null"], "default": null},
                  "altered_alertness": {"type": ["boolean", "null"], "default": null},
                  "focal_neurologic_deficit": {"type": ["boolean", "null"], "default": null},
                  "distracting_injury": {"type": ["boolean", "null"], "default": null},
                  "age": {"type": ["integer", "null"], "minimum": 0, "maximum": 120, "default": null}
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {"description": "NEXUS_NEGATIVE, NEXUS_POSITIVE, or INCOMPLETE result"},
          "422": {"description": "Invalid request schema"}
        }
      }
    }
  }
}
